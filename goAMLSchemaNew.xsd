<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning" xmlns:goaml="http://www.unodc.org/goaml" xmlns:xerces="http://xerces.apache.org" id="report" vc:minVersion="1.1" goaml:schemaVersion="5.0.2">
  <xs:element name="report">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="schema_version" minOccurs="0" goaml:supportedIn="5.1">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:minLength value="0" />
              <xs:maxLength value="25" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="rentity_id">
          <xs:simpleType>
            <xs:restriction base="xs:int">
              <xs:minInclusive value="1" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="rentity_branch" minOccurs="0">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:minLength value="0" />
              <xs:maxLength value="255" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="submission_code" type="submission_type" />
        <xs:element name="report_code" type="report_type" />
        <xs:element name="entity_reference">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="255" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="fiu_ref_number" minOccurs="0">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="255" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="prev_rejected_ref_number" minOccurs="0" goaml:supportedIn="5.1">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="255" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:choice>
          <xs:element name="submission_date" type="sql_date">
            <xs:annotation>
              <xs:documentation>The element will be deprecated in Schema 6</xs:documentation>
            </xs:annotation>
          </xs:element>
          <xs:element name="report_date" type="sql_date" goaml:supportedIn="5.0" />
        </xs:choice>
        <xs:element name="currency_code_local" type="currency_type" />
        <xs:choice minOccurs="1">
          <xs:element name="reporting_person" type="t_person_registration_in_report" />
          <xs:element name="reporting_user_code" goaml:supportedIn="5.1">
            <xs:simpleType>
              <xs:restriction base="xs:string">
                <xs:minLength value="4" />
                <xs:maxLength value="50" />
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
        </xs:choice>
        <xs:element name="location" type="t_address" minOccurs="0" />
        <xs:element name="reason" type="comments_type" minOccurs="0" />
        <xs:element name="action" type="comments_type" minOccurs="0" />
        <xs:choice>
          <xs:sequence>
            <xs:sequence maxOccurs="unbounded">
              <xs:element name="transaction">
                <xs:complexType>
                  <xs:sequence>
                    <xs:element name="transactionnumber">
                      <xs:simpleType>
                        <xs:annotation>
                          <xs:documentation>The transaction number length was extended to 100 chars</xs:documentation>
                        </xs:annotation>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="100" />
                          <xs:minLength value="1" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="transaction_is_suspicious" type="xs:boolean" minOccurs="0" goaml:supportedIn="5.1" />
                    <xs:element name="internal_ref_number" minOccurs="0">
                      <xs:simpleType>
                        <xs:annotation>
                          <xs:documentation>The internal ref number length was extended to 100 chars</xs:documentation>
                        </xs:annotation>
                        <xs:restriction base="xs:string">
                          <xs:minLength value="1" />
                          <xs:maxLength value="100" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="agent_name" minOccurs="0" goaml:supportedIn="5.1">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="255" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="transaction_location">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:pattern value="[_a-zA-Z0-9-+/ ]+" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="transaction_address" type="t_address" minOccurs="0" goaml:supportedIn="5.1" />
                    <xs:element name="transaction_description" type="comments_type" minOccurs="0" />
                    <xs:element name="date_transaction" type="sql_date" />
                    <xs:element name="teller" minOccurs="0">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="50" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="authorized" minOccurs="0">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="50" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:sequence minOccurs="0">
                      <xs:element name="late_deposit" minOccurs="0">
                        <xs:complexType>
                          <xs:simpleContent>
                            <xs:extension base="xs:boolean" />
                          </xs:simpleContent>
                        </xs:complexType>
                      </xs:element>
                      <xs:element name="date_posting" type="sql_date" minOccurs="0" />
                    </xs:sequence>
                    <xs:element name="value_date" type="sql_date" minOccurs="0" />
                    <xs:element name="transaction_type_code" type="transaction_type" minOccurs="0" goaml:supportedIn="5.1" />
                    <xs:element name="transmode_code" type="conduction_type" />
                    <xs:element name="transmode_comment" minOccurs="0">
                      <xs:simpleType>
                        <xs:restriction base="xs:string">
                          <xs:maxLength value="50" />
                        </xs:restriction>
                      </xs:simpleType>
                    </xs:element>
                    <xs:element name="amount_local" type="sql_decimal" />
                    <xs:element name="transaction_status" type="transaction_status_type" minOccurs="1" goaml:supportedIn="5.1" />
                    <xs:choice>
                      <xs:element name="involved_parties">
                        <xs:complexType>
                          <xs:sequence maxOccurs="unbounded">
                            <xs:element name="party" type="t_party" />
                          </xs:sequence>
                        </xs:complexType>
                      </xs:element>
                      <xs:sequence>
                        <xs:choice>
                          <xs:element name="t_from_my_client">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="from_funds_code" type="funds_type" />
                                <xs:element name="from_funds_comment" minOccurs="0">
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="255" />
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element name="from_transaction_additional_info" type="transaction_additional_info_type" minOccurs="0" goaml:supportedIn="5.1" />
                                <xs:element name="from_foreign_currency" type="t_foreign_currency" />
                                <xs:sequence>
                                  <xs:element name="conductor_is_suspected" type="xs:boolean" minOccurs="0" goaml:supportedIn="5.1" />
                                  <xs:element name="t_conductor" type="t_conductor_my_client" />
                                </xs:sequence>
                                <xs:sequence>
                                  <xs:element name="from_is_suspected" type="xs:boolean" minOccurs="0" goaml:supportedIn="5.1" />
                                  <xs:choice>
                                    <xs:element name="from_account" type="t_account_my_client" />
                                    <xs:element name="from_person" type="t_person_my_client" />
                                    <xs:element name="from_entity" type="t_entity_my_client" />
                                  </xs:choice>
                                </xs:sequence>
                                <xs:element name="from_country" type="country_type" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="t_from">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="from_funds_code" type="funds_type" />
                                <xs:element name="from_funds_comment" minOccurs="0">
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="255" />
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element name="from_transaction_additional_info" type="transaction_additional_info_type" minOccurs="0" goaml:supportedIn="5.1" />
                                <xs:element name="from_foreign_currency" type="t_foreign_currency" />
                                <xs:sequence>
                                  <xs:element name="conductor_is_suspected" type="xs:boolean" minOccurs="0" goaml:supportedIn="5.1" />
                                  <xs:element name="t_conductor" type="t_conductor" minOccurs="0" />
                                </xs:sequence>
                                <xs:sequence>
                                  <xs:element name="from_is_suspected" type="xs:boolean" minOccurs="0" goaml:supportedIn="5.1" />
                                  <xs:choice>
                                    <xs:element name="from_account" type="t_account" />
                                    <xs:element name="from_person" type="t_person" />
                                    <xs:element name="from_entity" type="t_entity" />
                                  </xs:choice>
                                </xs:sequence>
                                <xs:element name="from_country" type="country_type" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:choice>
                        <xs:choice>
                          <xs:element name="t_to_my_client">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="to_funds_code" type="funds_type" />
                                <xs:element name="to_funds_comment" minOccurs="0">
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="255" />
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element name="to_transaction_additional_info" type="transaction_additional_info_type" minOccurs="0" goaml:supportedIn="5.1" />
                                <xs:element name="to_foreign_currency" type="t_foreign_currency" />
                                <xs:sequence>
                                  <xs:element name="to_is_suspected" type="xs:boolean" minOccurs="0" goaml:supportedIn="5.1" />
                                  <xs:choice>
                                    <xs:element name="to_account" type="t_account_my_client" />
                                    <xs:element name="to_person" type="t_person_my_client" />
                                    <xs:element name="to_entity" type="t_entity_my_client" />
                                  </xs:choice>
                                </xs:sequence>
                                <xs:element name="to_country" type="country_type" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                          <xs:element name="t_to">
                            <xs:complexType>
                              <xs:sequence>
                                <xs:element name="to_funds_code" type="funds_type" />
                                <xs:element name="to_funds_comment" minOccurs="0">
                                  <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                      <xs:maxLength value="255" />
                                    </xs:restriction>
                                  </xs:simpleType>
                                </xs:element>
                                <xs:element name="to_transaction_additional_info" type="transaction_additional_info_type" minOccurs="0" goaml:supportedIn="5.1" />
                                <xs:element name="to_foreign_currency" type="t_foreign_currency" />
                                <xs:sequence>
                                  <xs:element name="to_is_suspected" type="xs:boolean" minOccurs="0" goaml:supportedIn="5.1" />
                                  <xs:choice>
                                    <xs:element name="to_account" type="t_account" />
                                    <xs:element name="to_person" type="t_person" />
                                    <xs:element name="to_entity" type="t_entity" />
                                  </xs:choice>
                                </xs:sequence>
                                <xs:element name="to_country" type="country_type" />
                              </xs:sequence>
                            </xs:complexType>
                          </xs:element>
                        </xs:choice>
                      </xs:sequence>
                    </xs:choice>
                    <xs:element name="goods_services" minOccurs="0">
                      <xs:complexType>
                        <xs:sequence maxOccurs="unbounded">
                          <xs:element name="item" type="t_trans_item" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="means_of_transport" minOccurs="0" goaml:supportedIn="5.2">
                      <xs:complexType>
                        <xs:sequence maxOccurs="unbounded">
                          <xs:element name="routing" type="route_type" />
                        </xs:sequence>
                      </xs:complexType>
                    </xs:element>
                    <xs:element name="comments" type="comments_type" minOccurs="0" />
                  </xs:sequence>
                  <xs:assert test="if (exists(t_from/from_foreign_currency) and t_from/from_foreign_currency/foreign_currency_code != 'TND')       then (t_from/from_foreign_currency/foreign_amount != amount_local)       else true()" xerces:message="Indiquez le montant local en TND dans le champ 'Amount_Local'/'Montant local', en utilisant le taux de change à la date de la transaction pour les opérations en devises." />
                  <xs:assert test="if (exists(t_from_my_client/from_foreign_currency) and t_from_my_client/from_foreign_currency/foreign_currency_code != 'TND')       then (t_from_my_client/from_foreign_currency/foreign_amount != amount_local)       else true()" xerces:message="Indiquez le montant local en TND dans le champ 'Amount_Local'/'Montant local', en utilisant le taux de change à la date de la transaction pour les opérations en devises." />
                  <xs:assert test="if (exists(t_to/to_foreign_currency) and t_to/to_foreign_currency/foreign_currency_code != 'TND')       then (t_to/to_foreign_currency/foreign_amount != amount_local)       else true()" xerces:message="Indiquez le montant local en TND dans le champ 'Amount_Local'/'Montant local', en utilisant le taux de change à la date de la transaction pour les opérations en devises." />
                  <xs:assert test="if (exists(t_to_my_client/to_foreign_currency) and t_to_my_client/to_foreign_currency/foreign_currency_code != 'TND')       then (t_to_my_client/to_foreign_currency/foreign_amount != amount_local)       else true()" xerces:message="Indiquez le montant local en TND dans le champ 'Amount_Local'/'Montant local', en utilisant le taux de change à la date de la transaction pour les opérations en devises." />
                </xs:complexType>
              </xs:element>
            </xs:sequence>
            <xs:element name="activity" type="activityType" minOccurs="0" goaml:supportedIn="5.0" />
          </xs:sequence>
          <xs:element name="activity" type="activityType" />
        </xs:choice>
        <xs:element name="report_indicators">
          <xs:complexType>
            <xs:sequence maxOccurs="unbounded">
              <xs:element name="indicator" type="report_indicator_type" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="additional_information" minOccurs="0" goaml:supportedIn="5.2">
          <xs:complexType>
            <xs:sequence maxOccurs="unbounded">
              <xs:element name="additional_info" type="generic_additional_info_type" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:assert test="if (report_code = 'SAR' or report_code = 'STR' or report_code = 'TAR' or report_code = 'TFR')    then count(tokenize(reason, '\s+')) &gt;= 149     else true()" xerces:message="Pour les rapports de types STR, SAR, TFR, TAR, le champ 'Motif de soupçon' doit contenir au moins 150 mots.    Veuillez développer le motif en fournissant une description détaillée des faits et une analyse des transactions concernées." />
      <xs:assert test="count(transaction/transactionnumber) eq count(distinct-values(transaction/transactionnumber))" xerces:message="Les numéros de transaction doivent être uniques." />
    </xs:complexType>
  </xs:element>
  <xs:complexType name="t_account_my_client">
    <xs:sequence>
      <xs:element name="institution_name" minOccurs="1">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="255" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:choice>
        <xs:element name="institution_code">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:minLength value="1" />
              <xs:maxLength value="50" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
        <xs:element name="swift">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:maxLength value="11" />
              <xs:minLength value="1" />
            </xs:restriction>
          </xs:simpleType>
        </xs:element>
      </xs:choice>
      <xs:element name="institution_country" type="country_type" minOccurs="0" goaml:supportedIn="5.1" />
      <xs:element name="non_bank_institution" type="xs:boolean" minOccurs="0" />
      <xs:element name="collection_account" type="xs:boolean" fixed="1" minOccurs="0" goaml:supportedIn="5.1" />
      <xs:element name="branch" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="255" />
            <xs:minLength value="1" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="account_category" type="account_category_type" minOccurs="0" goaml:supportedIn="5.1" />
      <xs:element name="account">
        <xs:annotation>
          <xs:documentation>
        The account length was extended to 255 chars
      </xs:documentation>
        </xs:annotation>
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="20" />
            <xs:minLength value="20" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="currency_code" type="currency_type" />
      <xs:element name="account_funds" minOccurs="0" goaml:supportedIn="5.1">
        <xs:complexType>
          <xs:sequence maxOccurs="unbounded">
            <xs:element name="account_fund" type="account_fund_type" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="account_name" minOccurs="1">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="255" />
            <xs:minLength value="1" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="iban" type="iban_type" minOccurs="0" />
      <xs:element name="client_number" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="34" />
            <xs:minLength value="1" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:choice>
        <xs:element name="personal_account_type" type="account_type">
          <xs:annotation>
            <xs:documentation>The element will be deprecated in Schema 6 and replaced by the new account_type element</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="account_type" type="account_type" goaml:supportedIn="5.1" />
      </xs:choice>
      <xs:element name="t_entity" type="t_entity_my_client" minOccurs="0" />
      <xs:element name="related_entities" minOccurs="0" goaml:supportedIn="5.1">
        <xs:complexType>
          <xs:sequence maxOccurs="unbounded">
            <xs:element name="account_related_entity" type="account_related_entity_type" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:choice>
        <xs:element name="signatory" maxOccurs="unbounded">
          <xs:annotation>
            <xs:documentation>The signatory node will be deprecated in Schema 6 and replaced by the new node related_persons</xs:documentation>
          </xs:annotation>
          <xs:complexType>
            <xs:sequence>
              <xs:element name="is_primary" fixed="1" minOccurs="0">
                <xs:simpleType>
                  <xs:restriction base="xs:boolean" />
                </xs:simpleType>
              </xs:element>
              <xs:element name="t_person" type="t_person_my_client" />
              <xs:element name="role" type="account_person_role_type" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="related_persons" goaml:supportedIn="5.1">
          <xs:complexType>
            <xs:sequence maxOccurs="unbounded">
              <xs:element name="account_related_person" type="account_related_person_my_client_type" />
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:choice>
      <xs:element name="related_accounts" minOccurs="0" goaml:supportedIn="5.1">
        <xs:complexType>
          <xs:sequence maxOccurs="unbounded">
            <xs:element name="account_related_account" type="account_related_account_type" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="opened" type="sql_date" />
      <xs:element name="closed" type="sql_date" minOccurs="0" />
      <xs:sequence>
        <xs:element name="balance" type="sql_decimal" minOccurs="1" />
        <xs:element name="date_balance" type="sql_date" />
      </xs:sequence>
      <xs:sequence>
        <xs:element name="status_code" type="account_status_type" />
        <xs:element name="status_date" type="sql_date" minOccurs="0" goaml:supportedIn="5.1" />
      </xs:sequence>
      <xs:element name="beneficiary" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="50" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="beneficiary_comment" minOccurs="0">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:maxLength value="255" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:element name="network_devices" minOccurs="0" goaml:supportedIn="5.2">
        <xs:complexType>
          <xs:sequence maxOccurs="unbounded">
            <xs:element name="network_device" type="network_device_type" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="sanctions" minOccurs="0" goaml:supportedIn="5.2">
        <xs:complexType>
          <xs:sequence maxOccurs="unbounded">
            <xs:element name="sanction_list" type="sanction_list_type" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="additional_information" minOccurs="0" goaml:supportedIn="5.2">
        <xs:complexType>
          <xs:sequence maxOccurs="unbounded">
            <xs:element name="additional_info" type="generic_additional_info_type" />
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <xs:element name="comments" type="comments_type" minOccurs="0" />
    </xs:sequence>
    <xs:assert test="if (exists(account_type) and account_type != '32CI') then matches(account, '^\d+$') else true()" xerces:message="Pour les comptes de vos clients,Le numéro de compte ne doit contenir que des chiffres, sauf s'il s'agit d'un compte interne." />
    <xs:assert test="if (exists(personal_account_type) and personal_account_type != '32CI') then matches(account, '^\d+$') else true()" xerces:message="Pour les comptes de vos clients, Le numéro de compte ne doit contenir que des chiffres, sauf s'il s'agit d'un compte interne." />
  </xs:complexType>
  <xs:complexType name="t_account">
    <xs:sequence>
      <xs:element name="institution_name" minOccurs="1">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1" />
            <xs:maxLength value="255" />
          </xs:restriction>
        </xs:simpleType>
      </xs:element>
      <xs:choice>
        <xs:element name="institution_code">
          <xs:simpleType>
            <xs:restriction base="xs:string">
              <xs:minLength value="1" />
              <xs:maxLength value="50" />
